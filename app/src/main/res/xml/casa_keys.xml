<?xml version="1.0" encoding="utf-8"?>
<!-- "Casa no filme": key filtering is requested dynamically in HouseKeyService only when a shortcut
     and house are active. Announcements are the rarest event type (one is required): apps report
     nothing else to us -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="1000" />
