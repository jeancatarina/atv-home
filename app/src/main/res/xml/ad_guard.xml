<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes: every other event type would make each app on screen report more to us.
     Keys are filtered only while the cover is up (AdGuardService.filterKeys): never a delay otherwise -->

<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500" />
